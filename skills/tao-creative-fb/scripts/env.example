# =====================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO SKILL TAO-CREATIVE-FB (GLOBALPHARMA)
# =====================================================================

# 1. Khóa API OpenAI
OPENAI_API_KEY=sk-proj-xxx

# Model tạo ảnh: gpt-image-1 (mặc định) hoặc dall-e-3
OPENAI_IMAGE_MODEL=gpt-image-1

# 2. Thông tin Facebook Graph API kết nối Fanpage GlobalPharma
FB_PAGE_ID=123456789
FB_PAGE_TOKEN=EAAxxx

# Phiên bản Graph API (mặc định v19.0 hoặc v20.0)
FB_GRAPH_VERSION=v19.0

# 3. Chế độ an toàn / kiểm thử
# Đặt 'true' hoặc '1' để kiểm thử: Script sẽ in ra console và lưu ảnh + caption ra file local mà không post FB thật
DRY_RUN=true
