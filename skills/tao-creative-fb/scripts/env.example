# =====================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO SKILL TAO-CREATIVE-FB (GLOBALPHARMA)
# =====================================================================

# 1. Khóa API OpenAI (Dùng để sinh ảnh DALL-E / gpt-image và tinh chỉnh caption nếu cần)
OPENAI_API_KEY="sk-proj-your_openai_api_key_here"

# Model tạo ảnh: dall-e-3 (mặc định) hoặc gpt-image-1
OPENAI_IMAGE_MODEL="dall-e-3"

# 2. Thông tin Facebook Graph API kết nối Fanpage GlobalPharma
# ID của Fanpage (ví dụ: 123456789012345)
FB_PAGE_ID="your_facebook_page_id"

# Page Access Token dài hạn (Page Token có quyền pages_manage_posts, pages_read_engagement)
FB_PAGE_TOKEN="EAAV..."

# Phiên bản Graph API (mặc định v19.0 hoặc v20.0)
FB_GRAPH_VERSION="v19.0"

# 3. Chế độ an toàn / kiểm thử
# Đặt 'true' hoặc '1' để kiểm thử: Script sẽ in ra payload và mô phỏng phản hồi mà không gửi bài thật lên Facebook
DRY_RUN=true
